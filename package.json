    "@codemirror/view": "^6.39.14",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.13.0",
    "@emotion/styled": "^11.13.0",
    "@fontsource/inter": "^5.0.18",
    "@lingui/core": "^6.12.0",
    "@lingui/detect-locale": "^6.12.0",
    "@lingui/react": "^6.12.0",
