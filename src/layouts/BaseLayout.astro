---
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/inter/latin-700.css';
import { ClientRouter } from 'astro:transitions';
import { SITE, locales, type Locale, localizePath, canonicalPath } from '../content/site';
import { navGroups, routes, pageTitle, canonicalUrl, webApplicationSchema, categoryLabel, routeSearchText, routeSearchPrimary, type RouteEntry } from '../content/routes';
import { staticSeoSection } from '../content/seoSections';

interface Props {
  route: RouteEntry;
  locale: Locale;
  robots?: string;
  loadTurnstile?: boolean;
  showLocaleSwitch?: boolean;
}

const {
  route,
  locale,
  robots = 'index, follow, max-snippet:-1, max-image-preview:large',
  loadTurnstile = true,
  showLocaleSwitch,
} = Astro.props;
const isIndexable = !robots.toLowerCase().includes('noindex');
const shouldShowLocaleSwitch = showLocaleSwitch ?? isIndexable;
const copy = route.copy[locale];
const title = pageTitle(route, locale);
const canonical = canonicalUrl(route, locale);
const localizedPath = localizePath(route.path, locale);
const companyRoutes = routes.filter((item) => item.category === 'Company');
const toolRoutes = routes.filter((item) => navGroups.some((group) => group === item.category));
const searchId = `tool-search-${locale}`;
const searchResultsId = `tool-search-results-${locale}`;
const mobileSearchId = `mobile-tool-search-${locale}`;
const mobileSearchResultsId = `mobile-tool-search-results-${locale}`;
const searchLabel = locale === 'fr' ? 'Rechercher un outil' : 'Search tools';
const searchPlaceholder = locale === 'fr' ? 'Rechercher un outil...' : 'Search tools...';
const noSearchResults = locale === 'fr' ? 'Aucun outil trouvé' : 'No tools found';
const hrefLangs: Record<Locale, string> = {
  en: 'en-US',
  fr: 'fr-FR',
};
const credits = [
  { name: 'Cloudflare', url: 'https://cloudflare.com' },
  { name: 'FFmpeg', url: 'https://ffmpeg.org' },
  { name: 'libvips', url: 'https://www.libvips.org' },
  { name: 'ImageMagick', url: 'https://imagemagick.org' },
  { name: 'Ghostscript', url: 'https://ghostscript.com' },
  { name: 'Tesseract', url: 'https://github.com/tesseract-ocr/tesseract' },
  { name: 'Pandoc', url: 'https://pandoc.org' },
  { name: 'ExifTool', url: 'https://exiftool.org' },
  { name: 'OpenSSL', url: 'https://openssl.org' },
  { name: 'QPDF', url: 'https://qpdf.sourceforge.io' },
  { name: 'Calibre', url: 'https://calibre-ebook.com' },
  { name: '7-Zip', url: 'https://7-zip.org' },
  { name: 'nsjail', url: 'https://nsjail.dev' },
];
const staticContent = isIndexable ? staticSeoSection(route, locale) : null;
const schema = isIndexable
  ? [
      webApplicationSchema(route, locale),
      route.path === '/'
        ? null
        : {
            '@context': 'https://schema.org',
            '@type': 'BreadcrumbList',
            itemListElement: [
              { '@type': 'ListItem', position: 1, name: locale === 'fr' ? 'Accueil' : 'Home', item: `${SITE.url}${canonicalPath('/', locale)}` },
              { '@type': 'ListItem', position: 2, name: copy.title, item: canonical },
            ],
          },
    ].filter(Boolean)
  : [];
---

<!doctype html>
<html lang={locale} data-joy-color-scheme="dark" transition:name="root" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
    <meta name="description" content={copy.description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#0F172A" />
    <ClientRouter fallback="swap" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {isIndexable && <link rel="canonical" href={canonical} />}
    {isIndexable && locales.map((item) => <link rel="alternate" hreflang={hrefLangs[item]} href={`${SITE.url}${canonicalPath(route.path, item)}`} />)}
    {isIndexable && <link rel="alternate" hreflang="x-default" href={`${SITE.url}${canonicalPath(route.path, 'en')}`} />}
    {loadTurnstile && <link rel="preconnect" href="https://challenges.cloudflare.com" />}
    {loadTurnstile && <link rel="dns-prefetch" href="https://challenges.cloudflare.com" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={copy.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:image" content={SITE.ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={copy.description} />
    <meta name="twitter:image" content={SITE.ogImage} />
    {schema.length > 0 && <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />}
    {loadTurnstile && <script src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer is:inline></script>}
  </head>
  <body data-path={localizedPath}>
    <div class="credits-banner">
      <nav class="credits-inner" aria-label={locale === 'fr' ? 'Remerciements' : 'Credits'}>
        <span class="credits-label">{locale === 'fr' ? 'Merci à' : 'Special thanks to'}</span>
        <ul class="credits-list">
          {credits.map((credit) => (
            <li>
              <a href={credit.url} target="_blank" rel="noopener noreferrer">{credit.name}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
    <div id="maintenance-banner" class="maintenance-banner" hidden>
      <span aria-hidden="true">!</span>
      <span>{locale === 'fr' ? 'Maintenance planifiée en cours, le service peut être brièvement indisponible' : 'Scheduled maintenance in progress, service may be briefly unavailable'}</span>
    </div>
    <div class="app-shell" data-mobile-drawer>
      <aside class="sidebar" aria-label="Primary navigation" data-tool-search-scope>
        <a class="brand" href={canonicalPath('/', locale)} aria-label="FileMagic home">
          <img src="/favicon.svg" alt="" width="24" height="24" />
          <span>FileMagic</span>
        </a>
        <p class="privacy-line">{locale === 'fr' ? 'Outils privés, gratuits, sans compte.' : 'Private, free tools. No account required.'}</p>
        <div class="sidebar-search" role="search">
          <label class="sr-only" for={searchId}>{searchLabel}</label>
          <input
            id={searchId}
            type="search"
            placeholder={searchPlaceholder}
            autocomplete="off"
            spellcheck="false"
            aria-controls={searchResultsId}
            aria-expanded="false"
            data-tool-search
          />
        </div>
        <nav class="nav-search-results" id={searchResultsId} aria-label={searchLabel} data-tool-search-results hidden>
          {toolRoutes.map((item) => (
            <a
              href={canonicalPath(item.path, locale)}
              aria-current={item.path === route.path ? 'page' : undefined}
              data-tool-result
              data-search={routeSearchText(item, locale)}
              data-search-primary={routeSearchPrimary(item, locale)}
              hidden
            >
              {item.copy[locale].navLabel}
            </a>
          ))}
          <p class="nav-search-empty" data-tool-search-empty hidden>{noSearchResults}</p>
        </nav>
        <p class="search-status sr-only" aria-live="polite" data-tool-search-status></p>
        <nav class="nav-groups" data-tool-nav-groups>
          {navGroups.map((group) => (
            <section class="nav-group">
              <h2>{categoryLabel(group, locale)}</h2>
              {routes.filter((item) => item.category === group).map((item) => (
                <a
                  href={canonicalPath(item.path, locale)}
                  aria-current={item.path === route.path ? 'page' : undefined}
                >
                  {item.copy[locale].navLabel}
                </a>
              ))}
            </section>
          ))}
        </nav>
        <nav class="company-links" aria-label="Company pages">
          {companyRoutes.map((item) => (
            <a href={canonicalPath(item.path, locale)} aria-current={item.path === route.path ? 'page' : undefined}>
              {item.copy[locale].navLabel}
            </a>
          ))}
        </nav>
        {shouldShowLocaleSwitch && (
          <div class="locale-switch" aria-label="Language">
            {locales.map((item) => (
              <a href={canonicalPath(route.path, item)} aria-current={item === locale ? 'true' : undefined}>{item.toUpperCase()}</a>
            ))}
          </div>
        )}
      </aside>
      <header class="mobile-header">
        <a class="mobile-brand" href={canonicalPath('/', locale)}>
          <img src="/favicon.svg" alt="" width="22" height="22" />
          <span>FileMagic</span>
        </a>
        <div class="mobile-actions">
          <details class="mobile-menu">
            <summary class="mobile-menu-trigger">
              <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
                <line x1="2.5" y1="4.5" x2="13.5" y2="4.5" />
                <line x1="2.5" y1="8" x2="13.5" y2="8" />
                <line x1="2.5" y1="11.5" x2="13.5" y2="11.5" />
              </svg>
              <span>{locale === 'fr' ? 'Outils' : 'Tools'}</span>
            </summary>
          </details>
          {shouldShowLocaleSwitch && (
            <a class="mobile-locale" href={canonicalPath(route.path, locale === 'fr' ? 'en' : 'fr')}>
              {locale === 'fr' ? 'EN' : 'FR'}
            </a>
          )}
        </div>
      </header>
      <div class="mobile-drawer-backdrop" data-drawer-backdrop></div>
      <aside class="mobile-drawer" aria-label={locale === 'fr' ? 'Navigation mobile' : 'Mobile navigation'} data-tool-search-scope>
          <button type="button" class="mobile-drawer-close" data-drawer-close aria-label={locale === 'fr' ? 'Fermer' : 'Close'}>
            <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
              <line x1="4.5" y1="4.5" x2="13.5" y2="13.5" />
              <line x1="13.5" y1="4.5" x2="4.5" y2="13.5" />
            </svg>
          </button>
          <div class="mobile-search" role="search">
            <label class="sr-only" for={mobileSearchId}>{searchLabel}</label>
            <input
              id={mobileSearchId}
              type="search"
              placeholder={searchPlaceholder}
              autocomplete="off"
              spellcheck="false"
              aria-controls={mobileSearchResultsId}
              aria-expanded="false"
              data-tool-search
            />
          </div>
          <nav class="nav-search-results" id={mobileSearchResultsId} aria-label={searchLabel} data-tool-search-results hidden>
            {toolRoutes.map((item) => (
              <a
                href={canonicalPath(item.path, locale)}
                aria-current={item.path === route.path ? 'page' : undefined}
                data-tool-result
                data-search={routeSearchText(item, locale)}
                data-search-primary={routeSearchPrimary(item, locale)}
                hidden
              >
                {item.copy[locale].navLabel}
              </a>
            ))}
            <p class="nav-search-empty" data-tool-search-empty hidden>{noSearchResults}</p>
          </nav>
          <p class="search-status sr-only" aria-live="polite" data-tool-search-status></p>
          <nav class="mobile-menu-groups" data-tool-nav-groups>
            {navGroups.map((group) => (
              <section>
                <h2>{categoryLabel(group, locale)}</h2>
                {routes.filter((item) => item.category === group).map((item) => (
                  <a
                    href={canonicalPath(item.path, locale)}
                    aria-current={item.path === route.path ? 'page' : undefined}
                  >
                    {item.copy[locale].navLabel}
                  </a>
                ))}
              </section>
            ))}
            <section>
              <h2>{categoryLabel('Company', locale)}</h2>
              {companyRoutes.map((item) => (
                <a href={canonicalPath(item.path, locale)} aria-current={item.path === route.path ? 'page' : undefined}>
                  {item.copy[locale].navLabel}
                </a>
              ))}
            </section>
          </nav>
        </aside>
      <main class="main-content">
        <section class="page-intro" aria-labelledby="page-title">
          <div>
            <p class="eyebrow">{categoryLabel(route.category, locale)}</p>
            <h1 id="page-title">{copy.title}</h1>
            <p class="lede">{copy.description}</p>
          </div>
          <div class="trust-strip" aria-label={locale === 'fr' ? 'Garanties de confiance' : 'Trust signals'}>
            <span>{locale === 'fr' ? 'Sans compte' : 'No account'}</span>
            <span>{locale === 'fr' ? 'Sans publicité' : 'No ads'}</span>
            <a href={canonicalPath('/security', locale)}>{locale === 'fr' ? 'Sécurité' : 'Security'}</a>
            <a href={canonicalPath('/privacy', locale)}>{locale === 'fr' ? 'Confidentialité' : 'Privacy'}</a>
          </div>
        </section>
        <slot />
        {staticContent && (
          <aside class="static-seo" aria-label={locale === 'fr' ? 'Informations sur l’outil' : 'Tool information'}>
            <section class="static-seo-section">
              <h2>{staticContent.howTo.title}</h2>
              <ol class="how-to-list">
                {staticContent.howTo.steps.map((step) => <li>{step}</li>)}
              </ol>
            </section>

            <section class="static-seo-section">
              <h2>{locale === 'fr' ? 'Points clés' : 'Key points'}</h2>
              <div class="feature-grid">
                {staticContent.features.map((feature) => (
                  <article>
                    <h3>{feature.title}</h3>
                    <p>{feature.description}</p>
                  </article>
                ))}
              </div>
            </section>

            <section class="static-seo-section">
              <h2>{locale === 'fr' ? 'Questions fréquentes' : 'Frequently asked questions'}</h2>
              <div class="faq-list">
                {staticContent.faq.map((item) => (
                  <details>
                    <summary>{item.question}</summary>
                    <p>{item.answer}</p>
                  </details>
                ))}
              </div>
            </section>

            {staticContent.relatedTools.length > 0 && (
              <nav class="related-tools" aria-label={locale === 'fr' ? 'Outils liés' : 'Related tools'}>
                <h2>{locale === 'fr' ? 'Outils liés' : 'Related tools'}</h2>
                <div>
                  {staticContent.relatedTools.map((tool) => <a href={tool.href}>{tool.label}</a>)}
                </div>
              </nav>
            )}
          </aside>
        )}
      </main>
    </div>
    <script is:inline>
      (() => {
        const shell = window.__fileMagicShell ??= {};

        shell.updateMaintenanceBanner = () => {
          const banner = document.getElementById('maintenance-banner');
          if (!banner) return;
          const now = new Date();
          banner.hidden = !(now.getUTCHours() === 5 && now.getUTCMinutes() < 20);
        };

        shell.initToolSearch = () => {
          const resultLabel = document.documentElement.lang === 'fr' ? ['résultat', 'résultats'] : ['result', 'results'];
          const normalizeSearch = (value) =>
            value
              .toLocaleLowerCase()
              .normalize('NFD')
              .replace(/[\u0300-\u036f]/g, '')
              .trim();
          const wordPrefixMatch = (haystack, query) =>
            haystack.split(' ').some((word) => word.startsWith(query));
          const scoreLink = (link, query) => {
            const primary = normalizeSearch(link.getAttribute('data-search-primary') || '');
            const full = normalizeSearch(link.getAttribute('data-search') || link.textContent || '');
            if (!full.includes(query)) return 0;
            if (primary === query) return 100;
            if (primary.startsWith(query)) return 80;
            if (wordPrefixMatch(primary, query)) return 60;
            if (primary.includes(query)) return 40;
            return 20;
          };

          document.querySelectorAll('[data-tool-search-scope]').forEach((scope) => {
            if (scope.dataset.toolSearchReady === 'true') return;
            scope.dataset.toolSearchReady = 'true';

            const searchInput = scope.querySelector('[data-tool-search]');
            const navGroupsElement = scope.querySelector('[data-tool-nav-groups]');
            const searchResultsElement = scope.querySelector('[data-tool-search-results]');
            const emptySearchElement = scope.querySelector('[data-tool-search-empty]');
            const searchStatusElement = scope.querySelector('[data-tool-search-status]');
            const searchResultLinks = Array.from(scope.querySelectorAll('[data-tool-result]'));
            const updateToolSearch = () => {
              if (!searchInput || !navGroupsElement || !searchResultsElement) return;
              const query = normalizeSearch(searchInput.value);
              searchInput.setAttribute('aria-expanded', query ? 'true' : 'false');
              if (!query) {
                searchResultsElement.hidden = true;
                navGroupsElement.hidden = false;
                searchResultLinks.forEach((link) => {
                  link.hidden = true;
                });
                if (emptySearchElement) emptySearchElement.hidden = true;
                if (searchStatusElement) searchStatusElement.textContent = '';
                searchResultsElement.dataset.topResult = '';
                return;
              }

              searchResultsElement.hidden = false;
              navGroupsElement.hidden = true;
              const matches = [];
              searchResultLinks.forEach((link, index) => {
                const score = scoreLink(link, query);
                link.hidden = score === 0;
                if (score > 0) matches.push({ link, score, index });
              });
              matches.sort((a, b) => (b.score - a.score) || (a.index - b.index));
              matches.forEach(({ link }) => searchResultsElement.appendChild(link));
              if (emptySearchElement) {
                searchResultsElement.appendChild(emptySearchElement);
                emptySearchElement.hidden = matches.length > 0;
              }
              searchResultsElement.dataset.topResult = matches.length ? (matches[0].link.getAttribute('href') || '') : '';
              if (searchStatusElement) {
                searchStatusElement.textContent = `${matches.length} ${matches.length === 1 ? resultLabel[0] : resultLabel[1]}`;
              }
            };

            if (searchInput) {
              searchInput.addEventListener('input', updateToolSearch);
              searchInput.addEventListener('search', updateToolSearch);
              searchInput.addEventListener('keydown', (event) => {
                if (event.isComposing) return;
                if (event.key === 'Enter') {
                  const href = searchResultsElement ? searchResultsElement.dataset.topResult : '';
                  if (href) {
                    event.preventDefault();
                    window.location.href = href;
                  }
                  return;
                }
                if (event.key !== 'Escape') return;
                if (searchInput.value) {
                  searchInput.value = '';
                  updateToolSearch();
                  event.stopPropagation();
                }
              });
            }
            searchResultLinks.forEach((link) => {
              link.addEventListener('click', () => {
                if (!searchInput) return;
                searchInput.value = '';
                updateToolSearch();
              });
            });
          });
        };

        shell.initMobileDrawer = () => {
          document.querySelectorAll('[data-mobile-drawer]').forEach((root) => {
            if (root.dataset.drawerReady === 'true') return;
            root.dataset.drawerReady = 'true';

            const details = root.querySelector('details.mobile-menu');
            if (!details) return;
            const summary = details.querySelector('summary');
            const backdrop = root.querySelector('[data-drawer-backdrop]');
            const drawer = root.querySelector('.mobile-drawer');
            const searchInput = drawer ? drawer.querySelector('[data-tool-search]') : null;
            const closeButton = drawer ? drawer.querySelector('[data-drawer-close]') : null;
            const close = () => {
              if (details.open) details.open = false;
            };
            const focusSearch = () => {
              if (!details.open || !searchInput) return;
              // flush the visibility:hidden -> visible change so focus() isn't a no-op
              searchInput.getBoundingClientRect();
              searchInput.focus();
            };

            details.addEventListener('toggle', () => {
              document.body.classList.toggle('drawer-open', details.open);
              if (details.open) {
                // rAF: let the <summary>'s own click-focus settle first, then move focus into the search field
                window.requestAnimationFrame(focusSearch);
              } else if (summary) {
                summary.focus();
              }
            });

            if (backdrop) backdrop.addEventListener('click', close);
            if (closeButton) closeButton.addEventListener('click', close);
            if (drawer) {
              drawer.querySelectorAll('a[href]').forEach((link) => {
                link.addEventListener('click', close);
              });
            }
          });

          if (!shell.drawerMediaBound) {
            shell.drawerMediaBound = true;
            window.matchMedia('(min-width: 900px)').addEventListener('change', (event) => {
              if (!event.matches) return;
              document.querySelectorAll('details.mobile-menu[open]').forEach((details) => {
                details.open = false;
              });
              document.body.classList.remove('drawer-open');
            });
          }
        };

        document.body.classList.remove('drawer-open');
        shell.updateMaintenanceBanner();
        shell.initToolSearch();
        shell.initMobileDrawer();

        if (!shell.isListening) {
          shell.isListening = true;
          window.setInterval(() => shell.updateMaintenanceBanner(), 30000);
          document.addEventListener('astro:page-load', () => {
            document.body.classList.remove('drawer-open');
            shell.updateMaintenanceBanner();
            shell.initToolSearch();
            shell.initMobileDrawer();
          });
          document.addEventListener('astro:before-swap', () => {
            const sidebar = document.querySelector('.sidebar');
            shell.sidebarScrollTop = sidebar instanceof HTMLElement ? sidebar.scrollTop : 0;
          });
          document.addEventListener('astro:after-swap', () => {
            const sidebar = document.querySelector('.sidebar');
            if (sidebar instanceof HTMLElement && typeof shell.sidebarScrollTop === 'number') {
              sidebar.scrollTop = shell.sidebarScrollTop;
            }
          });
          document.addEventListener('keydown', (event) => {
            if (event.key !== 'Escape') return;
            const details = document.querySelector('details.mobile-menu[open]');
            if (details instanceof HTMLDetailsElement) details.open = false;
          });
        }
      })();
    </script>
  </body>
</html>

<style>
  :root {
    color-scheme: dark;
    --bg: #0b1120;
    --surface: #131c2e;
    --surface-subtle: #1a2540;
    --border: #24324e;
    --text: #f1f5f9;
    --muted: #94a3b8;
    --faint: #64748b;
    --accent: #60a5fa;
    --accent-soft: #12254d;
  }

  :global(*),
  :global(*::before),
  :global(*::after) {
    box-sizing: border-box;
  }

  [hidden] {
    display: none !important;
  }

  :global(body.drawer-open) {
    overflow: hidden;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  html {
    font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    background: var(--bg);
    color: var(--text);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    -webkit-text-size-adjust: 100%;
  }

  body {
    margin: 0;
    min-height: 100vh;
    color: var(--text);
    background: var(--bg);
    font-size: 16px;
    line-height: 1.5;
  }

  a {
    color: inherit;
  }

  .credits-banner {
    position: relative;
    z-index: 12;
    border-bottom: 1px solid color-mix(in srgb, var(--border) 82%, transparent);
    background:
      linear-gradient(90deg, color-mix(in srgb, var(--accent) 10%, transparent), transparent 26%),
      color-mix(in srgb, var(--surface) 92%, var(--surface-subtle));
  }

  .credits-inner {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    row-gap: 6px;
    width: min(1180px, 100%);
    min-height: 38px;
    margin: 0 auto;
    padding: 6px 18px;
    overflow: visible;
  }

  .credits-label {
    position: relative;
    display: inline-flex;
    align-items: center;
    flex: 0 0 auto;
    min-height: 24px;
    padding-left: 13px;
    color: var(--muted);
    font-size: 11px;
    font-weight: 800;
    line-height: 1.1;
